{
  "wurk": 1,

  "beads": {
    "prefix": "uxsw",
    "sync": "dolthub",
    "topology": "beads",
    "areas": {
      "labels": [
        "area:codec",
        "area:monotonic",
        "area:conformance",
        "area:docs",
        "area:build"
      ],
      "lands_alone": ["area:build"],
      "always_batchable": ["upstream"]
    }
  },

  "forge": {
    "kind": "github",
    "labels": {}
  },

  "gate": {
    "full": ["mise", "run", "gate"],
    "loop": ["mise", "run", "gate:loop"],
    "build_paths": [
      "Sources/",
      "Tests/",
      "scripts/",
      "Package.swift",
      "Package.resolved",
      "mise.toml",
      ".swift-format",
      ".swift-version",
      ".editorconfig"
    ],
    "also_gated_paths": ["conformance/", "README.md"],
    "moving_files": [
      "mise.toml",
      "Package.swift",
      "Package.resolved",
      ".swift-format",
      ".editorconfig"
    ],
    "sabotage": {
      "test_roots": ["Tests/"],
      "test_pattern": "@Test\\b",
      "exempt_prefixes": [],
      "note_forms": ["comment", "in_name"]
    },
    "project_level_skips": [],
    "not_applicable_skips": []
  },

  "parallelism": {
    "model": "worktree-per-issue",
    "worktrees_dir": "../uxid-swift-worktrees",
    "trust": ["mise", "trust", "{path}"],
    "warm_clone": [],
    "warm": [["mise", "exec", "--", "swift", "package", "resolve"]],
    "repair_when": "Package.swift",
    "repair": [["mise", "exec", "--", "swift", "package", "resolve"]],
    "post_branch": []
  },

  "tmux": {
    "session": "uxid-swift",
    "model": "opus"
  },

  "models": {
    "direction": "fable"
  },

  "artifacts": {
    "plans": "docs/plans",
    "research": "docs/research",
    "filename": "YYMMDD-[id-]kebab"
  },

  "commits": {
    "style": "s-form",
    "subject_under": 72,
    "body_line_max": 72,
    "total_lines_max": 40,
    "trailer": {
      "key": "Refs"
    }
  },

  "changelog": {
    "mode": "fragments",
    "dir": "changelog.d"
  },

  "release": {
    "kind": "swiftpm",
    "version_file": "Sources/Uxid/Version.swift",
    "readme_pin": true
  }
}
